# ---------------------------------------------------------------------------
# VisionPilot 环境变量示例：复制为 .env 后按需修改
# 所有配置项都可用 VISIONPILOT_<字段名大写> 覆盖
# ---------------------------------------------------------------------------

# 执行模式：simulate（默认，安全演练）| live（真实鼠标键盘）
VISIONPILOT_EXECUTION_MODE=simulate

# 模拟模式下是否挂载合成桌面（便于离线演示与测试）
VISIONPILOT_SIMULATE_DESKTOP=true

# DeepSeek / OpenAI 兼容接口（留空则使用内置规则规划器）
DEEPSEEK_API_KEY=
VISIONPILOT_LLM_BASE_URL=https://api.deepseek.com
VISIONPILOT_LLM_MODEL=deepseek-chat
VISIONPILOT_LLM_VISION_MODEL=deepseek-chat
VISIONPILOT_PLANNER_MODE=auto
VISIONPILOT_LLM_ENABLED=true

# 循环与安全边界
VISIONPILOT_MAX_STEPS=20
VISIONPILOT_MAX_TASK_SECONDS=300
VISIONPILOT_MAX_RETRIES_PER_STEP=2
VISIONPILOT_MAX_REPLANS=2
VISIONPILOT_CONFIRM_DANGEROUS=true
VISIONPILOT_ALLOW_SHELL=false

# 感知
VISIONPILOT_SCREENSHOT_BACKEND=auto
VISIONPILOT_OCR_BACKEND=auto
VISIONPILOT_OCR_LANG=eng+chi_sim
VISIONPILOT_DETECT_UI_WITH_OPENCV=true
VISIONPILOT_KEEP_SCREENSHOTS=80

# API 服务
VISIONPILOT_API_HOST=127.0.0.1
VISIONPILOT_API_PORT=8765

# 日志与存储
VISIONPILOT_LOG_LEVEL=INFO
VISIONPILOT_DB_PATH=logs/visionpilot.db
VISIONPILOT_WORKSPACE_DIR=workspace
